{
  "rewrites": [
    { "source": "/home", "destination": "/api/app?page=home" },
    { "source": "/object-data", "destination": "/api/app?page=object-data" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
